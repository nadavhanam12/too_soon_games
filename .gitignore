# Operating system clutter
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files (keep shareable examples)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Dependencies and caches
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# Local logs
*.log

# itch.io local upload cache
.itch/

# Local video production dependencies and intermediates
.video-tools/
Video/Coldplay/build/
Video/Arcade/build/
Video/Arcade/build-energy/
Video/Arcade/build-youthful/
Video/CreativeProcess/build/

# itch.io staging output (from the itch-upload skill)
dist-itch/
dist-itch.changes.diff

# Cloudflare / template build outputs and local secrets
.dev.vars
.wrangler/
dist/
.local-dist/
backups/
GamesTemplate/other-services/bugcheck/out/

# make-music: candidate audio stays local (WAV masters ~15 MB each); shipped MP3s live in assets/audio,
# prompts + seeds in runs/*/prompts.json are enough to regenerate (GamesTemplate/other-services/skills/make-music)
Games/*/music/runs/*/raw/
Games/*/music/runs/*/game/

# internal legal / research notes: local only, never committed
research_notes/

# PublishGamesPipeline: heavy media and personal data (journalists, creators, emails) stay local
Games/*/launch/videos/
Games/*/launch/private/
Games/*/launch/.work/
PublishGamesPipeline/private/
Games/*/launch/press/
