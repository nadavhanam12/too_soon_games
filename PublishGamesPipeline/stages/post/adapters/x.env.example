# Copy to PublishGamesPipeline/private/x.env (that folder is never in git) and fill it yourself.
# From console.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Client Secret:
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match a callback URI registered in the app's User authentication settings, character for character:
X_REDIRECT_URI=https://toosoongames.app/
# Written by `node x.mjs auth-url` and `node x.mjs exchange <code>`. Do not edit:
X_PKCE_VERIFIER=
X_REFRESH_TOKEN=
