# Copy to PublishGamesPipeline/private/facebook.env (that folder is never in git) and fill it yourself.
# The Page's numeric id (Page → About → Page transparency, or /me/accounts in Graph API Explorer):
FACEBOOK_PAGE_ID=
# A Page access token with pages_show_list, pages_read_engagement and pages_manage_posts, taken from /me/accounts
# with an extended user token, so it does not expire (steps in the header of facebook.mjs):
FACEBOOK_PAGE_TOKEN=
