# Copy to PublishGamesPipeline/private/tiktok.env (that folder is never in git) and fill it yourself.
# From developers.tiktok.com → your app → Credentials:
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a redirect URI registered in the app's Login Kit, character for character:
TIKTOK_REDIRECT_URI=https://toosoongames.app/
# SELF_ONLY until TikTok audits the app (and the account must be set to private); then PUBLIC_TO_EVERYONE:
TIKTOK_PRIVACY=SELF_ONLY
# Written by `node tiktok.mjs exchange <code>` and replaced on every use. Do not edit:
TIKTOK_REFRESH_TOKEN=
